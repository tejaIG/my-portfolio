# EmailJS Configuration (Required)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=service_xxxxxxxxx
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=template_xxxxxxxxx  
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxx

# App Configuration (Required for hybrid EmailJS + API approach)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# For production: NEXT_PUBLIC_APP_URL=https://your-domain.com

# Site Analytics (Optional)
NEXT_PUBLIC_GTM=

# Contact Form Captcha (Optional)
NEXT_PUBLIC_RECAPTCHA_SECRET_KEY=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Telegram Bot Notifications (Optional - for API route)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=